[Unit]
Description=Bigtop OpenMetadata governance glossary and table annotation (manual only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 {{ governance_catalog_enrichment_install_dir }}/enrich_catalog.py --apply --url {{ governance_catalog_enrichment_api_url }} --token-file {{ governance_catalog_enrichment_secret_file }} --policy {{ governance_catalog_enrichment_policy_file }}
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
