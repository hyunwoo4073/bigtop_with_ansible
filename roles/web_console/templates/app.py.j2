@app.get("/api/runbooks")
def api_runbooks():
    items = []
    seen = set()

    for service, runbook in RUNBOOKS.items():
        if service == "default":
            continue

        key = (runbook["title"], runbook["path"])
        if key in seen:
            continue

        seen.add(key)
        items.append({
            "title": runbook["title"],
            "path": runbook["path"],
            "url": runbook["url"],
            "reason": runbook["reason"],
        })

    return {
        "count": len(items),
        "items": items,
    }


@app.get("/runbooks", response_class=HTMLResponse)
def api_runbooks_page():
    return render_runbooks_html(api_runbooks())


@app.get("/runbooks/{runbook_name:path}", response_class=PlainTextResponse)
def api_runbook_file(runbook_name: str):
    safe_name = runbook_name.strip("/")

    if safe_name == "README.md":
        candidate = Path(PROJECT_DIR) / "README.md"
    else:
        candidate = Path(PROJECT_DIR) / "docs" / "runbooks" / safe_name

    root = Path(PROJECT_DIR).resolve()
    resolved = candidate.resolve()

    if not str(resolved).startswith(str(root)):
        raise HTTPException(status_code=400, detail="Invalid runbook path")

    if not resolved.exists() or not resolved.is_file():
        raise HTTPException(status_code=404, detail=f"Runbook not found: {safe_name}")

    return resolved.read_text(encoding="utf-8")


# BEGIN BIGTOP INVENTORY READ API V1
# This is a read-only projection of the Ansible-managed PostgreSQL metadata.
# It is NOT the source of truth for running services or lifecycle commands.
@app.get('/api/metadata')
def api_platform_metadata(include_absent: bool = False):
    import os as _inventory_os
    from fastapi import HTTPException as _InventoryHTTPException

    dsn = _inventory_os.environ.get('WEB_CONSOLE_DB_DSN')
    if not dsn:
        raise _InventoryHTTPException(status_code=503, detail='PostgreSQL metadata store is not configured')
    try:
        import psycopg as _inventory_psycopg
        with _inventory_psycopg.connect(dsn, connect_timeout=5) as conn:
            with conn.cursor() as cur:
                cur.execute('''
                    SELECT cluster_slug, description, last_synced_at
                    FROM public.platform_clusters
                    ORDER BY cluster_slug LIMIT 50
                ''')
                clusters = [
                    {'slug': slug, 'description': description,
                     'last_synced_at': synced.isoformat() if synced else None}
                    for slug, description, synced in cur.fetchall()
                ]
                cur.execute('''
                    SELECT cluster_slug, host_name, inventory_address,
                           inventory_groups, is_present, last_seen_at
                    FROM public.platform_hosts
                    WHERE (%s OR is_present)
                    ORDER BY cluster_slug, host_name LIMIT 2000
                ''', (include_absent,))
                hosts = [
                    {'cluster_slug': cluster, 'name': name, 'address': addr,
                     'groups': groups if isinstance(groups, list) else [],
                     'is_present': present,
                     'last_seen_at': seen.isoformat() if seen else None}
                    for cluster, name, addr, groups, present, seen in cur.fetchall()
                ]
                cur.execute('''
                    SELECT cluster_slug, host_name, service_name,
                           component_name, group_name, is_present
                    FROM public.platform_service_instances
                    WHERE (%s OR is_present)
                    ORDER BY cluster_slug, host_name, group_name, service_name
                    LIMIT 5000
                ''', (include_absent,))
                services = [
                    {'cluster_slug': cluster, 'host': host, 'service': service,
                     'component': component, 'group': group, 'is_present': present}
                    for cluster, host, service, component, group, present in cur.fetchall()
                ]
                cur.execute('''
                    SELECT cluster_slug, synced_at, host_count, service_count
                    FROM public.platform_metadata_sync_runs
                    ORDER BY id DESC LIMIT 1
                ''')
                sync = cur.fetchone()
    except Exception as exc:
        # Do not include the exception or DSN in public HTTP responses.
        print(f'[inventory-query-error] {type(exc).__name__}', flush=True)
        raise _InventoryHTTPException(status_code=503, detail='Metadata database unavailable or not synchronized') from None

    return {
        'ok': True, 'source': 'postgresql:ansible-inventory-snapshot',
        'read_only': True, 'include_absent': include_absent,
        'clusters': clusters, 'hosts': hosts, 'services': services,
        'summary': {'clusters': len(clusters), 'hosts': len(hosts), 'services': len(services)},
        'latest_sync': {
            'cluster_slug': sync[0], 'at': sync[1].isoformat() if sync[1] else None,
            'host_count': sync[2], 'service_count': sync[3]
        } if sync else None,
        'note': 'Inventory snapshot only; service availability is shown in Services and Health.',
    }
# END BIGTOP INVENTORY READ API V1


# BEGIN BIGTOP POSTGRES BACKUP DASHBOARD API V1
# Read-only Prometheus proxy: never touches PostgreSQL, filesystem or systemd.
@app.get('/api/ops/postgresql-backup')
def api_postgresql_backup_dashboard():
    import math as _pgb_math
    import os as _pgb_os
    import time as _pgb_time
    from urllib.parse import urlencode as _pgb_urlencode
    from urllib.request import Request as _PGBRequest, urlopen as _pgb_urlopen

    endpoint = _pgb_os.environ.get('WEB_CONSOLE_PROMETHEUS_URL',
                                    'http://127.0.0.1:9090').rstrip('/')
    checked_at = int(_pgb_time.time())
    expected = (
        'collector_success', 'last_check_timestamp_seconds', 'archive_count',
        'latest_archive_size_bytes', 'latest_archive_timestamp_seconds',
        'latest_archive_valid', 'last_valid_timestamp_seconds', 'timer_active',
    )
    prefix = 'bigtop_web_console_pg_backup_'
    errors = []
    issues = []
    metrics = {}
    alerts = []
    expected_alerts = {
        'BigtopPGBackupNoArchives', 'BigtopPGBackupStale',
        'BigtopPGBackupLatestArchiveInvalid', 'BigtopPGBackupTimerInactive',
        'BigtopPGBackupCollectorFailed', 'BigtopPGBackupObserverStale',
        'BigtopPGBackupMetricsMissing',
    }
    rules_loaded = False
    alertmanager_connected = None

    def query_prometheus(path, params=None):
        url = endpoint + path
        if params:
            url += '?' + _pgb_urlencode(params)
        with _pgb_urlopen(_PGBRequest(url, headers={'Accept': 'application/json'}),
                          timeout=4) as response:
            result = __import__('json').load(response)
        if not isinstance(result, dict) or result.get('status') != 'success':
            raise ValueError('Unexpected Prometheus API response')
        return result.get('data') or {}

    try:
        data = query_prometheus('/api/v1/query', {
            'query': '{__name__=~"bigtop_web_console_pg_backup_.*"}',
        })
        duplicates = set()
        for item in data.get('result', []):
            full_name = item.get('metric', {}).get('__name__', '')
            key = full_name[len(prefix):] if full_name.startswith(prefix) else ''
            if key not in expected:
                continue
            if key in metrics:
                duplicates.add(key)
                continue
            raw = item.get('value', [None, None])
            number = float(raw[1])
            if not _pgb_math.isfinite(number):
                raise ValueError('Non-finite metric')
            metrics[key] = number
        if duplicates:
            errors.append('Duplicate backup metric series: ' + ', '.join(sorted(duplicates)))
        missing = sorted(set(expected).difference(metrics))
        if missing:
            errors.append('Missing backup metrics: ' + ', '.join(missing))
    except Exception:
        errors.append('Cannot read PostgreSQL backup metrics from Prometheus')

    try:
        data = query_prometheus('/api/v1/rules', {'type': 'alert'})
        for group in data.get('groups', []):
            if group.get('name') != 'bigtop-postgresql-backup':
                continue
            rules_loaded = True
            for rule in group.get('rules', []):
                if rule.get('type') != 'alerting':
                    continue
                if rule.get('labels', {}).get('component') != 'postgresql-backup':
                    continue
                alerts.append({
                    'name': str(rule.get('name', '')),
                    'state': str(rule.get('state', 'unknown')),
                    'severity': str(rule.get('labels', {}).get('severity', 'unknown')),
                    'summary': str(rule.get('annotations', {}).get('summary', '')),
                })
        alerts.sort(key=lambda row: row['name'])
        missing_alerts = expected_alerts - {item['name'] for item in alerts}
        if not rules_loaded or missing_alerts:
            errors.append('Missing PostgreSQL backup alert rules: ' +
                          ', '.join(sorted(missing_alerts)))
    except Exception:
        errors.append('Cannot read PostgreSQL backup alert rules')

    try:
        data = query_prometheus('/api/v1/alertmanagers')
        alertmanager_connected = bool(data.get('activeAlertmanagers', []))
        if not alertmanager_connected:
            issues.append('Prometheus has no active Alertmanager')
    except Exception:
        errors.append('Cannot verify Prometheus Alertmanager connection')

    # Missing or ambiguous data MUST NEVER be reported as HEALTHY.
    state = 'UNKNOWN' if errors else 'HEALTHY'
    age = None
    check_age = None
    if 'latest_archive_timestamp_seconds' in metrics:
        age = max(0, checked_at - metrics['latest_archive_timestamp_seconds'])
    if 'last_check_timestamp_seconds' in metrics:
        check_age = max(0, checked_at - metrics['last_check_timestamp_seconds'])
    if len(metrics) == len(expected):
        if metrics['collector_success'] != 1:
            issues.append('Backup observer reported a failure')
        if metrics['archive_count'] < 1:
            issues.append('No PostgreSQL backup archives available')
        if metrics['latest_archive_valid'] != 1:
            issues.append('Latest PostgreSQL backup is not valid')
        if metrics['timer_active'] != 1:
            issues.append('Backup systemd timer is inactive')
        if age is not None and age > 93600:
            issues.append('Latest backup is older than 26 hours')
        if check_age is not None and check_age > 1800:
            issues.append('Backup observer is older than 30 minutes')
    for item in alerts:
        if item['state'] in ('firing', 'pending'):
            issues.append('Backup alert ' + item['name'] + ' is ' + item['state'])
    if issues and not errors:
        state = 'DEGRADED'
    return {
        'ok': state == 'HEALTHY', 'read_only': True, 'status': state,
        'source': 'prometheus', 'checked_at': checked_at,
        'thresholds': {'backup_age_seconds': 93600, 'observer_age_seconds': 1800},
        'metrics': {key: metrics.get(key) for key in expected},
        'backup_age_seconds': age, 'observer_age_seconds': check_age,
        'rules_loaded': rules_loaded, 'alertmanager_connected': alertmanager_connected,
        'alerts': alerts,
        'alert_summary': {
            'total': len(alerts),
            'firing': sum(a['state'] == 'firing' for a in alerts),
            'pending': sum(a['state'] == 'pending' for a in alerts),
        },
        'issues': issues, 'errors': errors,
    }
# END BIGTOP POSTGRES BACKUP DASHBOARD API V1


