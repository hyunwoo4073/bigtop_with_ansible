import os
import shlex
import subprocess
from datetime import datetime
from pathlib import Path
from typing import Dict, List

from fastapi import FastAPI, HTTPException
from fastapi.responses import PlainTextResponse
from fastapi.staticfiles import StaticFiles


PROJECT_DIR = os.environ.get("PROJECT_DIR", "{{ web_console_project_root | default(playbook_dir ~ '/..') }}")
OPSCTL = os.environ.get("OPSCTL", "/usr/local/bin/bigtop-opsctl")
FRONTEND_DIST_DIR = os.environ.get("FRONTEND_DIST_DIR", "/opt/bigtop-web-console/frontend-src/dist")

REQUEST_TIMEOUT = 60
STATUS_TIMEOUT = 8
JOURNAL_LINES = 160

app = FastAPI(title="Bigtop Web Console API")


COMPONENTS = [
    {"group": "HDFS", "component": "NameNode", "host": "master", "service": "hadoop-hdfs-namenode"},
    {"group": "HDFS", "component": "DataNode", "host": "worker1", "service": "hadoop-hdfs-datanode"},
    {"group": "HDFS", "component": "DataNode", "host": "worker2", "service": "hadoop-hdfs-datanode"},
    {"group": "YARN", "component": "ResourceManager", "host": "master", "service": "hadoop-yarn-resourcemanager"},
    {"group": "YARN", "component": "NodeManager", "host": "worker1", "service": "hadoop-yarn-nodemanager"},
    {"group": "YARN", "component": "NodeManager", "host": "worker2", "service": "hadoop-yarn-nodemanager"},
    {"group": "Spark", "component": "History Server", "host": "master", "service": "spark-history-server"},
    {"group": "Monitoring", "component": "Prometheus", "host": "worker3", "service": "prometheus"},
    {"group": "Monitoring", "component": "Grafana", "host": "worker3", "service": "grafana-server"},
    {"group": "Monitoring", "component": "Alertmanager", "host": "worker3", "service": "prometheus-alertmanager"},
    {"group": "Ops", "component": "Web Console", "host": "worker3", "service": "bigtop-web-console"},
    {"group": "Ops", "component": "Nginx", "host": "worker3", "service": "nginx"},
    {"group": "Ops", "component": "OliveTin", "host": "worker3", "service": "OliveTin"},
]

STOP_PROTECTED_SERVICES = {
    "bigtop-web-console",
    "nginx",
}


def run_cmd(cmd: str, timeout: int = REQUEST_TIMEOUT) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        shell=True,
        cwd=PROJECT_DIR,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
    )


def ansible_shell(host: str, command: str, become: bool = True, timeout: int = REQUEST_TIMEOUT) -> subprocess.CompletedProcess:
    quoted_command = shlex.quote(command)
    become_flag = "-b " if become else ""
    cmd = f"ansible {shlex.quote(host)} {become_flag}-m shell -a {quoted_command}"
    return run_cmd(cmd, timeout=timeout)


def component_id(component: Dict[str, str]) -> str:
    return f"{component['host']}::{component['service']}"


def find_component(component_id_value: str) -> Dict[str, str]:
    for component in COMPONENTS:
        if component_id(component) == component_id_value:
            return component
    raise HTTPException(status_code=404, detail=f"Unknown component: {component_id_value}")


def parse_systemd_output(output: str) -> Dict[str, str]:
    active = "unknown"
    sub = "unknown"
    pid = "-"
    load = "unknown"

    for raw_line in output.splitlines():
        line = raw_line.strip()

        if line in {"active", "inactive", "failed", "activating", "deactivating"}:
            active = line
        elif line.startswith("ActiveState="):
            active = line.split("=", 1)[1]
        elif line.startswith("SubState="):
            sub = line.split("=", 1)[1]
        elif line.startswith("MainPID="):
            pid = line.split("=", 1)[1]
        elif line.startswith("LoadState="):
            load = line.split("=", 1)[1]

    status = "UP" if active == "active" else "DOWN"

    return {
        "status": status,
        "active": active,
        "sub": sub,
        "pid": pid if pid and pid != "0" else "-",
        "load": load,
    }


def systemd_status(host: str, service: str) -> Dict[str, str]:
    command = (
        f"systemctl is-active {shlex.quote(service)}; "
        f"systemctl show {shlex.quote(service)} "
        "--property=ActiveState --property=SubState --property=MainPID --property=LoadState --no-page"
    )

    try:
        result = ansible_shell(host, command, become=True, timeout=STATUS_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {
            "status": "UNKNOWN",
            "active": "timeout",
            "sub": "timeout",
            "pid": "-",
            "load": "unknown",
        }

    output = (result.stdout or "") + "\n" + (result.stderr or "")
    return parse_systemd_output(output)


def build_status() -> Dict:
    checked_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    components = []
    groups: Dict[str, List[Dict]] = {}
    nodes: Dict[str, List[Dict]] = {}

    for item in COMPONENTS:
        state = systemd_status(item["host"], item["service"])

        row = {
            **item,
            "id": component_id(item),
            "status": state["status"],
            "active": state["active"],
            "sub": state["sub"],
            "pid": state["pid"],
            "load": state["load"],
            "checked_at": checked_at,
        }

        components.append(row)
        groups.setdefault(item["group"], []).append(row)
        nodes.setdefault(item["host"], []).append(row)

    summary = []
    for group, rows in groups.items():
        total = len(rows)
        up = sum(1 for row in rows if row["status"] == "UP")
        down = total - up

        if down == 0:
            status = "HEALTHY"
        elif up == 0:
            status = "DOWN"
        else:
            status = "DEGRADED"

        summary.append({"group": group, "status": status, "up": up, "down": down, "total": total})

    node_summary = []
    for host, rows in nodes.items():
        total = len(rows)
        up = sum(1 for row in rows if row["status"] == "UP")
        down = total - up

        if down == 0:
            status = "HEALTHY"
        elif up == 0:
            status = "DOWN"
        else:
            status = "DEGRADED"

        node_summary.append({"host": host, "status": status, "up": up, "down": down, "total": total, "components": rows})

    issues = [
        {
            "severity": "CRITICAL",
            "message": f"{row['group']} {row['component']} on {row['host']} is {row['status']}",
            "component_id": row["id"],
            "group": row["group"],
            "component": row["component"],
            "service": row["service"],
            "host": row["host"],
        }
        for row in components
        if row["status"] != "UP"
    ]

    cluster_status = "HEALTHY"
    if any(item["status"] == "DOWN" for item in summary):
        cluster_status = "DOWN"
    elif any(item["status"] == "DEGRADED" for item in summary):
        cluster_status = "DEGRADED"

    total_components = len(components)
    up_components = sum(1 for item in components if item["status"] == "UP")

    return {
        "checked_at": checked_at,
        "cluster_status": cluster_status,
        "summary": summary,
        "nodes": node_summary,
        "components": components,
        "issues": issues,
        "metrics": {
            "total_components": total_components,
            "up_components": up_components,
            "down_components": total_components - up_components,
            "issue_count": len(issues),
        },
    }


@app.get("/api/health")
def health():
    return {"status": "ok", "service": "bigtop-web-console"}


@app.get("/api/status")
def api_status():
    return build_status()


@app.get("/api/component/{component_id_value:path}/logs", response_class=PlainTextResponse)
def api_component_logs(component_id_value: str):
    component = find_component(component_id_value)
    service = component["service"]
    host = component["host"]

    command = f"journalctl -u {shlex.quote(service)} -n {JOURNAL_LINES} --no-pager"
    result = ansible_shell(host, command, become=True, timeout=REQUEST_TIMEOUT)

    output = result.stdout or ""
    if result.stderr:
        output += "\n[stderr]\n" + result.stderr

    return output or "(no logs)"


def run_component_lifecycle(component_id_value: str, action: str) -> Dict:
    if action not in {"start", "stop", "restart"}:
        raise HTTPException(status_code=400, detail=f"Unsupported action: {action}")

    component = find_component(component_id_value)
    service = component["service"]
    host = component["host"]

    if action == "stop" and service in STOP_PROTECTED_SERVICES:
        raise HTTPException(
            status_code=400,
            detail=f"Stop is blocked for protected service: {service}",
        )

    quoted_service = shlex.quote(service)

    command = (
        f"systemctl {action} {quoted_service}; "
        "rc=$?; "
        f"systemctl is-active {quoted_service}; "
        "exit $rc"
    )

    result = ansible_shell(host, command, become=True, timeout=REQUEST_TIMEOUT)

    return {
        "component": component,
        "action": action,
        "returncode": result.returncode,
        "stdout": result.stdout,
        "stderr": result.stderr,
        "ok": result.returncode == 0,
    }


@app.post("/api/component/{component_id_value:path}/start")
def api_component_start(component_id_value: str):
    return run_component_lifecycle(component_id_value, "start")


@app.post("/api/component/{component_id_value:path}/stop")
def api_component_stop(component_id_value: str):
    return run_component_lifecycle(component_id_value, "stop")


@app.post("/api/component/{component_id_value:path}/restart")
def api_component_restart(component_id_value: str):
    return run_component_lifecycle(component_id_value, "restart")


@app.post("/api/action/incident-summary")
def api_incident_summary():
    if not Path(OPSCTL).exists():
        return {
            "ok": False,
            "returncode": 127,
            "stdout": "",
            "stderr": f"OPSCTL not found: {OPSCTL}",
        }

    result = run_cmd(f"{shlex.quote(OPSCTL)} incident-summary", timeout=REQUEST_TIMEOUT)

    return {
        "ok": result.returncode == 0,
        "returncode": result.returncode,
        "stdout": result.stdout,
        "stderr": result.stderr,
    }


frontend_path = Path(FRONTEND_DIST_DIR)

if frontend_path.exists():
    app.mount("/", StaticFiles(directory=str(frontend_path), html=True), name="frontend")
else:
    @app.get("/", response_class=PlainTextResponse)
    def frontend_missing():
        return f"Frontend build directory not found: {FRONTEND_DIST_DIR}"
