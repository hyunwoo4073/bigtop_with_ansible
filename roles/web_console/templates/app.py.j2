def run_cmd(cmd: str, timeout: int = REQUEST_TIMEOUT) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        shell=True,
        cwd=PROJECT_DIR,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
    )


def ansible_shell(host: str, command: str, become: bool = True, timeout: int = REQUEST_TIMEOUT) -> subprocess.CompletedProcess:
    quoted_command = shlex.quote(command)
    become_flag = "-b " if become else ""
    cmd = f"ansible {shlex.quote(host)} {become_flag}-m shell -a {quoted_command}"
    return run_cmd(cmd, timeout=timeout)


def component_id(component: Dict[str, str]) -> str:
    return f"{component['host']}::{component['service']}"


def find_component(component_id_value: str) -> Dict[str, str]:
    for component in COMPONENTS:
        if component_id(component) == component_id_value:
            return component

    raise HTTPException(status_code=404, detail=f"Unknown component: {component_id_value}")


def runbook_for_issue(row: Dict) -> Dict:
    return RUNBOOKS.get(row.get("service"), RUNBOOKS["default"])


def compact_text(value: str, limit: int = 4000) -> str:
    if not value:
        return ""

    value = str(value)
    if len(value) <= limit:
        return value

    return value[:limit] + "\n...[truncated]"


# Optional PostgreSQL store. Existing JSONL remains a durable fallback.
WEB_CONSOLE_DB_DSN = os.environ.get("WEB_CONSOLE_DB_DSN", "")


def _db_connect():
    import psycopg
    return psycopg.connect(WEB_CONSOLE_DB_DSN, connect_timeout=3)


def _db_write_action(record: Dict) -> None:
    if not WEB_CONSOLE_DB_DSN:
        return
    try:
        with _db_connect() as conn:
            with conn.cursor() as cur:
                cur.execute(
                    """INSERT INTO action_history
                       (event_id, recorded_at, action, host, service, ok, blocked, payload)
                       VALUES (%s::uuid, %s, %s, %s, %s, %s, %s, %s::jsonb)
                       ON CONFLICT (event_id) DO NOTHING""",
                    (record["event_id"], record["recorded_at"], record.get("action"),
                     record.get("host"), record.get("service"), record.get("ok"),
                     bool(record.get("blocked", False)),
                     json.dumps(record, ensure_ascii=False, default=str)),
                )
    except Exception as exc:
        # Service control must never fail merely because PostgreSQL is down.
        print(f"[postgres-audit-warning] {type(exc).__name__}", flush=True)


def _db_read_actions(limit: int) -> Dict:
    with _db_connect() as conn:
        with conn.cursor() as cur:
            cur.execute(
                "SELECT payload FROM action_history ORDER BY seq DESC LIMIT %s",
                (limit,),
            )
            items = [row[0] for row in cur.fetchall()]
    return {"path": "postgresql:action_history", "count": len(items),
            "items": items, "storage": "postgresql"}


def append_action_audit(record: Dict) -> None:
    audit_record = {
        "event_id": str(uuid.uuid4()),
        "recorded_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        **record,
    }

    try:
        audit_path = Path(ACTION_AUDIT_LOG)
        audit_path.parent.mkdir(parents=True, exist_ok=True)

        with audit_path.open("a", encoding="utf-8") as file:
            file.write(json.dumps(audit_record, ensure_ascii=False, default=str) + "\n")
    except Exception as exc:
        print(f"[audit-log-error] {exc}", flush=True)

    _db_write_action(audit_record)


def read_action_audit(limit: int = 50) -> Dict:
    limit = max(1, min(int(limit), ACTION_AUDIT_LOG_MAX_ITEMS))
    if WEB_CONSOLE_DB_DSN:
        try:
            return _db_read_actions(limit)
        except Exception as exc:
            print(f"[postgres-read-warning] {type(exc).__name__}", flush=True)
    audit_path = Path(ACTION_AUDIT_LOG)

    if not audit_path.exists():
        return {
            "path": str(audit_path),
            "count": 0,
            "items": [],
        }

    try:
        lines = audit_path.read_text(encoding="utf-8").splitlines()
    except Exception as exc:
        return {
            "path": str(audit_path),
            "count": 0,
            "items": [],
            "error": str(exc),
        }

    items = []
    for line in lines[-limit:]:
        if not line.strip():
            continue

        try:
            items.append(json.loads(line))
        except json.JSONDecodeError:
            items.append({"raw": line, "parse_error": True})

    items.reverse()

    return {
        "path": str(audit_path),
        "count": len(items),
        "items": items,
    }


def parse_systemd_output(output: str) -> Dict[str, str]:
    active = "unknown"
    sub = "unknown"
    pid = "-"
    load = "unknown"

    for raw_line in output.splitlines():
        line = raw_line.strip()

        if line in {"active", "inactive", "failed", "activating", "deactivating"}:
            active = line
        elif line.startswith("ActiveState="):
            active = line.split("=", 1)[1]
        elif line.startswith("SubState="):
            sub = line.split("=", 1)[1]
        elif line.startswith("MainPID="):
            pid = line.split("=", 1)[1]
        elif line.startswith("LoadState="):
            load = line.split("=", 1)[1]

    status = "UP" if active == "active" else "DOWN"

    return {
        "status": status,
        "active": active,
        "sub": sub,
        "pid": pid if pid and pid != "0" else "-",
        "load": load,
    }


def systemd_status(host: str, service: str) -> Dict[str, str]:
    command = (
        f"systemctl is-active {shlex.quote(service)}; "
        f"systemctl show {shlex.quote(service)} "
        "--property=ActiveState --property=SubState --property=MainPID --property=LoadState --no-page"
    )

    try:
        result = ansible_shell(host, command, become=True, timeout=STATUS_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {
            "status": "UNKNOWN",
            "active": "timeout",
            "sub": "timeout",
            "pid": "-",
            "load": "unknown",
        }

    output = (result.stdout or "") + "\n" + (result.stderr or "")
    return parse_systemd_output(output)


def build_status() -> Dict:
    checked_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    components = []
    groups: Dict[str, List[Dict]] = {}
    nodes: Dict[str, List[Dict]] = {}

    for item in COMPONENTS:
        state = systemd_status(item["host"], item["service"])

        row = {
            **item,
            "id": component_id(item),
            "status": state["status"],
            "active": state["active"],
            "sub": state["sub"],
            "pid": state["pid"],
            "load": state["load"],
            "checked_at": checked_at,
        }

        components.append(row)
        groups.setdefault(item["group"], []).append(row)
        nodes.setdefault(item["host"], []).append(row)

    summary = []
    for group, rows in groups.items():
        total = len(rows)
        up = sum(1 for row in rows if row["status"] == "UP")
        down = total - up

        if down == 0:
            status = "HEALTHY"
        elif up == 0:
            status = "DOWN"
        else:
            status = "DEGRADED"

        summary.append({"group": group, "status": status, "up": up, "down": down, "total": total})

    node_summary = []
    for host, rows in nodes.items():
        total = len(rows)
        up = sum(1 for row in rows if row["status"] == "UP")
        down = total - up

        if down == 0:
            status = "HEALTHY"
        elif up == 0:
            status = "DOWN"
        else:
            status = "DEGRADED"

        node_summary.append({"host": host, "status": status, "up": up, "down": down, "total": total, "components": rows})

    issues = [
        {
            "severity": "CRITICAL",
            "message": f"{row['group']} {row['component']} on {row['host']} is {row['status']}",
            "component_id": row["id"],
            "group": row["group"],
            "component": row["component"],
            "service": row["service"],
            "host": row["host"],
            "runbook": runbook_for_issue(row),
        }
        for row in components
        if row["status"] != "UP"
    ]

    cluster_status = "HEALTHY"
    if any(item["status"] == "DOWN" for item in summary):
        cluster_status = "DOWN"
    elif any(item["status"] == "DEGRADED" for item in summary):
        cluster_status = "DEGRADED"

    total_components = len(components)
    up_components = sum(1 for item in components if item["status"] == "UP")

    return {
        "checked_at": checked_at,
        "cluster_status": cluster_status,
        "summary": summary,
        "nodes": node_summary,
        "components": components,
        "issues": issues,
        "metrics": {
            "total_components": total_components,
            "up_components": up_components,
            "down_components": total_components - up_components,
            "issue_count": len(issues),
        },
    }


def build_self_check() -> Dict:
    frontend_path = Path(FRONTEND_DIST_DIR)
    project_path = Path(PROJECT_DIR)
    opsctl_path = Path(OPSCTL)
    audit_log_path = Path(ACTION_AUDIT_LOG)
    audit_log_dir = audit_log_path.parent
    logrotate_path = Path("/etc/logrotate.d/bigtop-web-console-actions")

    checks = {
        "project_dir_exists": project_path.exists(),
        "project_dir_is_dir": project_path.is_dir(),
        "frontend_dist_exists": frontend_path.exists(),
        "frontend_dist_is_dir": frontend_path.is_dir(),
        "opsctl_exists": opsctl_path.exists(),
        "ansible_available": shutil.which("ansible") is not None,
        "audit_log_dir_exists": audit_log_dir.exists(),
        "audit_log_dir_writable": audit_log_dir.exists() and os.access(str(audit_log_dir), os.W_OK),
        "audit_log_file_exists": audit_log_path.exists(),
        "audit_log_file_writable": audit_log_path.exists() and os.access(str(audit_log_path), os.W_OK),
        "logrotate_config_exists": logrotate_path.exists(),
    }

    warnings = []

    if not checks["project_dir_exists"]:
        warnings.append(f"PROJECT_DIR does not exist: {PROJECT_DIR}")

    if not checks["frontend_dist_exists"]:
        warnings.append(f"Frontend dist directory does not exist: {FRONTEND_DIST_DIR}")

    if not checks["ansible_available"]:
        warnings.append("ansible command is not available in service PATH")

    if not checks["audit_log_dir_exists"]:
        warnings.append(f"Audit log directory does not exist: {audit_log_dir}")

    if checks["audit_log_dir_exists"] and not checks["audit_log_dir_writable"]:
        warnings.append(f"Audit log directory is not writable by Web Console process: {audit_log_dir}")

    if checks["audit_log_file_exists"] and not checks["audit_log_file_writable"]:
        warnings.append(f"Audit log file is not writable by Web Console process: {audit_log_path}")

    if not checks["logrotate_config_exists"]:
        warnings.append(f"Logrotate config does not exist: {logrotate_path}")

    return {
        "status": "ok" if not warnings else "warning",
        "service": "bigtop-web-console",
        "checked_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "paths": {
            "project_dir": PROJECT_DIR,
            "frontend_dist_dir": FRONTEND_DIST_DIR,
            "opsctl": OPSCTL,
            "audit_log": str(audit_log_path),
            "audit_log_dir": str(audit_log_dir),
            "logrotate_config": str(logrotate_path),
        },
        "checks": checks,
        "warnings": warnings,
    }


