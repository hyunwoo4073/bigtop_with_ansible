@app.post("/api/action/incident-summary")
def api_incident_summary():
    if not Path(OPSCTL).exists():
        return {
            "ok": False,
            "returncode": 127,
            "stdout": "",
            "stderr": f"OPSCTL not found: {OPSCTL}",
        }

    result = run_cmd(f"{shlex.quote(OPSCTL)} incident-summary", timeout=REQUEST_TIMEOUT)

    return {
        "ok": result.returncode == 0,
        "returncode": result.returncode,
        "stdout": result.stdout,
        "stderr": result.stderr,
    }


@app.get("/api/storage/health")
def api_storage_health():
    if not WEB_CONSOLE_DB_DSN:
        return {"storage": "file", "postgresql": "disabled", "ok": False}
    try:
        with _db_connect() as conn:
            with conn.cursor() as cur:
                cur.execute("SELECT count(*) FROM action_history")
                count = cur.fetchone()[0]
        return {"storage": "postgresql", "postgresql": "connected", "ok": True,
                "action_count": count}
    except Exception as exc:
        return {"storage": "file", "postgresql": "unavailable", "ok": False,
                "error_type": type(exc).__name__}


