@app.get("/api/runbooks")
def api_runbooks():
    items = []
    seen = set()

    for service, runbook in RUNBOOKS.items():
        if service == "default":
            continue

        key = (runbook["title"], runbook["path"])
        if key in seen:
            continue

        seen.add(key)
        items.append({
            "title": runbook["title"],
            "path": runbook["path"],
            "url": runbook["url"],
            "reason": runbook["reason"],
        })

    return {
        "count": len(items),
        "items": items,
    }


@app.get("/runbooks", response_class=HTMLResponse)
def api_runbooks_page():
    return render_runbooks_html(api_runbooks())


@app.get("/runbooks/{runbook_name:path}", response_class=PlainTextResponse)
def api_runbook_file(runbook_name: str):
    safe_name = runbook_name.strip("/")

    if safe_name == "README.md":
        candidate = Path(PROJECT_DIR) / "README.md"
    else:
        candidate = Path(PROJECT_DIR) / "docs" / "runbooks" / safe_name

    root = Path(PROJECT_DIR).resolve()
    resolved = candidate.resolve()

    if not str(resolved).startswith(str(root)):
        raise HTTPException(status_code=400, detail="Invalid runbook path")

    if not resolved.exists() or not resolved.is_file():
        raise HTTPException(status_code=404, detail=f"Runbook not found: {safe_name}")

    return resolved.read_text(encoding="utf-8")


