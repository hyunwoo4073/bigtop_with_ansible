# START_STOP_ACTION_ENDPOINTS_V1
# Additional service lifecycle endpoints.
# Restart existed first as the safest MVP action.
# Start/Stop are added separately for operational completeness.
import re as _svc_re
import subprocess as _svc_subprocess

_ALLOWED_SERVICE_ACTIONS = {
    "start": "started",
    "stop": "stopped",
}

_STOP_PROTECTED_SERVICES = {
    "bigtop-web-console",
    "nginx",
}


def _component_runtime_id(component):
    return component.get("id") or f"{component.get('host')}::{component.get('service')}"


def _find_component_for_lifecycle(component_id_value):
    for component in COMPONENTS:
        if _component_runtime_id(component) == component_id_value:
            return component

    raise HTTPException(status_code=404, detail=f"unknown component: {component_id_value}")


def _validate_lifecycle_target(host, service):
    if not _svc_re.match(r"^[A-Za-z0-9_.-]+$", host):
        raise HTTPException(status_code=400, detail=f"invalid host: {host}")

    if not _svc_re.match(r"^[A-Za-z0-9_.@-]+$", service):
        raise HTTPException(status_code=400, detail=f"invalid service: {service}")


def _run_lifecycle_action(component_id_value, action_name):
    if action_name not in _ALLOWED_SERVICE_ACTIONS:
        raise HTTPException(status_code=400, detail=f"unsupported action: {action_name}")

    component = _find_component_for_lifecycle(component_id_value)

    host = component["host"]
    service = component["service"]
    desired_state = _ALLOWED_SERVICE_ACTIONS[action_name]

    _validate_lifecycle_target(host, service)

    if action_name == "stop" and service in _STOP_PROTECTED_SERVICES:
        raise HTTPException(
            status_code=400,
            detail=f"stop is blocked for protected service: {service}",
        )

    cmd = [
        "ansible",
        host,
        "-b",
        "-m",
        "ansible.builtin.systemd",
        "-a",
        f"name={service} state={desired_state}",
    ]

    result = _svc_subprocess.run(
        cmd,
        cwd="{{ web_console_project_root | default(playbook_dir ~ '/..') }}",
        text=True,
        capture_output=True,
        timeout=120,
    )

    return {
        "ok": result.returncode == 0,
        "action": action_name,
        "host": host,
        "service": service,
        "returncode": result.returncode,
        "stdout": result.stdout,
        "stderr": result.stderr,
    }


@app.post("/api/component/{component_id_value:path}/start")
async def start_component(component_id_value: str):
    return _run_lifecycle_action(component_id_value, "start")


@app.post("/api/component/{component_id_value:path}/stop")
async def stop_component(component_id_value: str):
    return _run_lifecycle_action(component_id_value, "stop")



