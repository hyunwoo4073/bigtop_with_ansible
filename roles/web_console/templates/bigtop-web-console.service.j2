[Unit]
Description=Bigtop Unified Web Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ web_console_run_user }}
Group={{ web_console_run_user }}
WorkingDirectory={{ web_console_app_dir }}
Environment=PROJECT_DIR={{ web_console_project_dir }}
Environment=OPSCTL={{ web_console_opsctl }}
Environment=FRONTEND_DIST_DIR={{ web_console_frontend_dist_dir }}
ExecStart={{ web_console_venv_dir }}/bin/uvicorn app:app --host {{ web_console_host }} --port {{ web_console_port }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
