[Unit]
Description=Backup Bigtop Web Console PostgreSQL database
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
ExecStart={{ web_console_pg_backup_script_dir }}/pg_backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
Nice=10
